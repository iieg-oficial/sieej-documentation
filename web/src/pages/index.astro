---
import Layout from "../layouts/Layout.astro";
import SeccionSieej from "../components/SeccionSieej.astro";
import SeccionCatalogo from "../components/SeccionCatalogo.astro";
import SeccionNumeralia from "../components/SeccionNumeralia.astro";
import SeccionVistas from "../components/SeccionVistas.astro";
---

<Layout>
  <section class="heroe" aria-labelledby="titulo-heroe">
    <div class="contenedor">
      <p class="heroe__direccion">Dirección del Sistema de Información</p>
      <h1 id="titulo-heroe">Sistema de Información Estratégica del Estado de Jalisco</h1>
      <p class="heroe__resumen">
        Documentación pública del SIEEJ: qué es el sistema, el catálogo de sus pipelines ETL en
        producción, la numeralia que cruza Airflow con la base de datos, y la estructura de sus
        vistas materializadas.
      </p>
      <div class="heroe__acciones">
        <a href="#catalogo" class="pildora pildora--acento">Ver catálogo</a>
        <a href="#vistas" class="pildora pildora--clara">Estructura de vistas</a>
      </div>
    </div>
  </section>

  <SeccionSieej />
  <SeccionCatalogo />
  <SeccionNumeralia />
  <SeccionVistas />
</Layout>

<style>
  .heroe {
    background: var(--brand-vivo);
    color: #fff;
    padding: 3.5rem 0 4rem;
  }

  .heroe__direccion {
    margin: 0 0 0.75rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.85);
  }

  .heroe h1 {
    color: #fff;
    max-width: 48rem;
  }

  .heroe__resumen {
    max-width: 46rem;
    font-size: 1.125rem;
    color: rgba(255, 255, 255, 0.95);
    margin: 0;
  }

  .heroe__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .pildora {
    display: inline-flex;
    align-items: center;
    height: 2.5rem;
    padding: 0 1.5rem;
    border-radius: 999px;
    font-weight: 700;
    text-decoration: none;
    transition: background 0.15s, color 0.15s;
  }

  .pildora--acento {
    background: var(--acento);
    color: var(--titulo);
  }

  .pildora--acento:hover {
    background: #ff9d00;
    color: var(--titulo);
  }

  .pildora--clara {
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.5);
  }

  .pildora--clara:hover {
    background: #fff;
    color: var(--brand);
  }
</style>
