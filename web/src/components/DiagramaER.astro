---
import ELK from "elkjs/lib/elk.bundled.js";
import type { Base } from "../lib/documentos";

interface Props {
  base: Base;
  svg?: string | null;
}

const { base, svg = null } = Astro.props;
const usarSvg = Boolean(svg) && base.relaciones.length === 0;

const MAX_OTRAS = 6;
const ALTO_CABECERA = 30;
const ALTO_FILA = 18;
const ANCHO_CARACTER = 7.1;

const fks = new Map<string, Set<string>>();
for (const r of base.relaciones) {
  const set = fks.get(r.tabla) ?? new Set<string>();
  r.columnas.forEach((c) => set.add(c));
  fks.set(r.tabla, set);
}

const nodos = base.tablas.map((t) => {
  const llaves = fks.get(t.nombre) ?? new Set<string>();
  const clave = t.columnas.filter((c) => c.pk || llaves.has(c.nombre));
  const otras = t.columnas.filter((c) => !c.pk && !llaves.has(c.nombre));
  const visibles = [...clave, ...otras.slice(0, MAX_OTRAS)].map((c) => ({
    ...c,
    fk: llaves.has(c.nombre),
  }));
  const ocultas = otras.length - Math.min(otras.length, MAX_OTRAS);
  const textos = [t.nombre.length + 2, ...visibles.map((c) => c.nombre.length + c.tipo.length + 7)];
  const ancho = Math.min(380, Math.max(170, Math.max(...textos) * ANCHO_CARACTER + 24));
  const filas = visibles.length + (ocultas > 0 ? 1 : 0);
  return { id: t.nombre, visibles, ocultas, width: ancho, height: ALTO_CABECERA + filas * ALTO_FILA + 10 };
});

const ids = new Set(nodos.map((n) => n.id));
const aristas = base.relaciones
  .filter((r) => ids.has(r.tabla) && ids.has(r.ref_tabla) && r.tabla !== r.ref_tabla)
  .map((r, i) => ({ id: `e${i}`, sources: [r.tabla], targets: [r.ref_tabla] }));

const elk = new ELK();
const grafo = usarSvg ? { children: [], edges: [], width: 0, height: 0 } : await elk.layout({
  id: "raiz",
  layoutOptions: {
    "elk.algorithm": "layered",
    "elk.direction": "RIGHT",
    "elk.edgeRouting": "ORTHOGONAL",
    "elk.spacing.nodeNode": "28",
    "elk.layered.spacing.nodeNodeBetweenLayers": "70",
    "elk.spacing.componentComponent": "40",
    "elk.padding": "[top=16,left=16,bottom=16,right=16]",
  },
  children: nodos.map(({ id, width, height }) => ({ id, width, height })),
  edges: aristas,
});

const posicion = new Map((grafo.children ?? []).map((n) => [n.id, n]));
const anchoSvg = Number(svg?.match(/viewBox="0 0 ([\d.]+)/)?.[1] ?? 0);
const ancho = usarSvg ? Math.ceil(anchoSvg) : Math.ceil(grafo.width ?? 0);
const alto = Math.ceil(grafo.height ?? 0);
const trazos = (grafo.edges ?? []).flatMap((e) =>
  (e.sections ?? []).map((s) =>
    [s.startPoint, ...(s.bendPoints ?? []), s.endPoint].map((p, i) => `${i ? "L" : "M"}${p.x} ${p.y}`).join(" "),
  ),
);
const id = `der-${base.nombre}`;
---

<div class="der" id={id} data-ancho={ancho}>
  <div class="der__controles">
    <button type="button" data-zoom="1.25" aria-label="Acercar el diagrama">+</button>
    <button type="button" data-zoom="0.8" aria-label="Alejar el diagrama">−</button>
    <button type="button" data-zoom="ajustar" aria-label="Ajustar el diagrama al ancho">Ajustar</button>
  </div>
  <div class="der__lienzo">
    {usarSvg && <div class="der__repo" role="img" aria-label={`Diagrama entidad-relación de ${base.nombre}`} set:html={svg} />}
    {!usarSvg && <svg
      viewBox={`0 0 ${ancho} ${alto}`}
      width={ancho}
      height={alto}
      role="img"
      aria-label={`Diagrama entidad-relación de ${base.nombre}: ${nodos.length} tablas y ${aristas.length} relaciones`}
    >
      <defs>
        <marker id={`${id}-flecha`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0 0L10 5L0 10z" fill="#8894ae"></path>
        </marker>
      </defs>
      {trazos.map((d) => <path d={d} fill="none" stroke="#8894ae" stroke-width="1.5" marker-end={`url(#${id}-flecha)`} />)}
      {
        nodos.map((n) => {
          const p = posicion.get(n.id)!;
          return (
            <g transform={`translate(${p.x} ${p.y})`}>
              <rect width={n.width} height={n.height} rx="8" fill="#ffffff" stroke="#d5ddef" />
              <path d={`M0 8a8 8 0 0 1 8-8h${n.width - 16}a8 8 0 0 1 8 8v${ALTO_CABECERA - 8}h-${n.width}z`} fill="#5c2472" />
              <text x="10" y="20" class="der__tabla">{n.id}</text>
              {n.visibles.map((c, i) => (
                <g transform={`translate(0 ${ALTO_CABECERA + 14 + i * ALTO_FILA})`}>
                  {c.pk && <text x="10" class="der__marca der__marca--pk">PK</text>}
                  {!c.pk && c.fk && <text x="10" class="der__marca der__marca--fk">FK</text>}
                  <text x="32" class="der__columna">{c.nombre}</text>
                  <text x={n.width - 10} text-anchor="end" class="der__tipo">{c.tipo}</text>
                </g>
              ))}
              {n.ocultas > 0 && (
                <text x="32" y={ALTO_CABECERA + 14 + n.visibles.length * ALTO_FILA} class="der__mas">
                  +{n.ocultas} columnas
                </text>
              )}
            </g>
          );
        })
      }
    </svg>}
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>(".der").forEach((der) => {
    const svg = der.querySelector("svg");
    const natural = Number(der.dataset.ancho);
    if (!svg || !natural) return;
    svg.removeAttribute("height");
    let escala = 1;
    const ajustar = () => {
      escala = Math.min(1, der.clientWidth / natural);
      svg.style.width = `${natural * escala}px`;
      svg.style.height = "auto";
    };
    ajustar();
    der.querySelectorAll<HTMLButtonElement>("[data-zoom]").forEach((boton) => {
      boton.addEventListener("click", () => {
        if (boton.dataset.zoom === "ajustar") return ajustar();
        escala = Math.min(3, Math.max(0.2, escala * Number(boton.dataset.zoom)));
        svg.style.width = `${natural * escala}px`;
      });
    });
  });
</script>

<style>
  .der {
    position: relative;
    border: 1px solid var(--linea);
    border-radius: 0.75rem;
    background: var(--fondo);
  }

  .der__controles {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    z-index: 2;
    display: flex;
    gap: 0.35rem;
  }

  .der__controles button {
    min-width: 2rem;
    height: 2rem;
    padding: 0 0.7rem;
    border: 0;
    border-radius: 999px;
    background: var(--brand-suave);
    color: var(--brand);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .der__controles button:hover {
    background: var(--brand);
    color: #fff;
  }

  .der__lienzo {
    overflow: auto;
    max-height: 75vh;
    padding: 2.75rem 0.5rem 0.5rem;
  }

  .der svg,
  .der__repo :global(svg) {
    display: block;
    max-width: none;
    margin: 0 auto;
  }

  .der__tabla {
    fill: #fff;
    font-family: var(--fuente-codigo);
    font-size: 12px;
    font-weight: 600;
  }

  .der__columna {
    fill: var(--titulo);
    font-family: var(--fuente-codigo);
    font-size: 11px;
  }

  .der__tipo,
  .der__mas {
    fill: var(--silenciado);
    font-size: 10px;
  }

  .der__marca {
    font-size: 9px;
    font-weight: 700;
  }

  .der__marca--pk {
    fill: #9e5200;
  }

  .der__marca--fk {
    fill: var(--brand-vivo);
  }
</style>
