---
import Layout from "../../layouts/Layout.astro";
import BarraLateral from "../../components/BarraLateral.astro";
import Info from "../../components/Info.astro";
import { enLinea } from "../../lib/markdown";
import { leerJson } from "../../lib/datos";
import { listarPipelines } from "../../lib/documentos";

const [vistas, pipelines] = await Promise.all([leerJson<any>("vistas.json"), listarPipelines()]);
const base = vistas?.bases.find((b: any) => b.nombre === Astro.params.bd);
if (!vistas || !base) return new Response(null, { status: 404 });
const bdOk = vistas.fuentes?.bd?.estado === "ok";

const pipeline = pipelines.find((p) => p.clave === base.nombre);
const notas = [
  base.es_infraestructura
    ? "Base de infraestructura geoespacial: sus vistas son de sistema (PostGIS), no producto de un pipeline."
    : null,
  bdOk ? null : "Estructura según la documentación del pipeline; la introspección de la BD está pendiente de acceso.",
].filter((n): n is string => n !== null);
const secciones = base.vistas.map((v: any) => ({ href: `#vista-${v.nombre}`, texto: v.nombre }));
const otras = vistas.bases.map((b: any) => ({
  href: `/vistas/${b.nombre}/`,
  texto: b.nombre,
  actual: b.nombre === base.nombre,
}));

const registros = base.vistas.reduce((n: number, v: any) => n + (v.registros ?? 0), 0);
const cifras = [
  { valor: base.vistas.length.toLocaleString("es-MX"), etiqueta: "vistas" },
  {
    valor: base.vistas.filter((v: any) => v.tipo === "MATERIALIZED VIEW").length.toLocaleString("es-MX"),
    etiqueta: "materializadas",
  },
  { valor: registros ? registros.toLocaleString("es-MX") : "—", etiqueta: "registros" },
  {
    valor: pipeline?.titulo ?? (base.es_infraestructura ? "Infraestructura" : "—"),
    etiqueta: "pipeline",
  },
];

const TIPO_INSIGNIA: Record<string, string> = {
  VIEW: "insignia--neutra",
  "MATERIALIZED VIEW": "insignia--ok",
};
---

<Layout
  titulo={`${base.nombre} — Estructura de vistas — SIEEJ`}
  descripcion={`Columnas, tipos y descripciones de las vistas de la base de datos ${base.nombre} del SIEEJ.`}
>
  <section class="bloque" aria-labelledby="titulo-bd">
    <div class="contenedor">
      <div class="cabecera">
      <div class="cabecera__titulo">
      <nav aria-label="Miga de pan" class="miga">
        <a href="/#vistas">Estructura de vistas</a>
        <span aria-hidden="true"> / </span>
        <span aria-current="page">{base.nombre}</span>
      </nav>
      <h1 id="titulo-bd" class="titulo-bd">
        {base.nombre}
        {notas.length > 0 && <Info textos={notas} etiqueta="Notas de esta base" />}
      </h1>
      {
        pipeline && (
          <p class="enlace-pipeline">
            <a href={`/pipelines/${pipeline.clave}/`}>Documentación del pipeline</a>
          </p>
        )
      }
      </div>
      <dl class="cifras">
        {cifras.map((c) => (
          <div class="cifra">
            <dt>{c.etiqueta}</dt>
            <dd>{c.valor}</dd>
          </div>
        ))}
      </dl>
      </div>

      <div class="cuerpo">
      <BarraLateral
        secciones={secciones}
        tituloSecciones="Vistas de esta base"
        otros={otras}
        tituloOtros="Otras bases"
      />
      <div class="contenido">
      {
        base.vistas.map((vista) => (
          <article class="tarjeta vista" id={`vista-${vista.nombre}`} aria-label={`Vista ${vista.nombre}`}>
            <header class="vista__cabecera">
              <h3>
                <code>
                  {vista.esquema}.{vista.nombre}
                </code>
              </h3>
              <p class="vista__insignias">
                <span class={`insignia ${TIPO_INSIGNIA[vista.tipo] ?? "insignia--neutra"}`}>
                  {vista.tipo === "MATERIALIZED VIEW" ? "Vista materializada" : "Vista"}
                </span>
                {vista.solo_en_bd && (
                  <span class="insignia insignia--pendiente">
                    En la BD, sin documentación estática
                  </span>
                )}
                {vista.solo_en_docs && (
                  <span class="insignia insignia--desactualizado">
                    Documentada, no encontrada en la BD
                  </span>
                )}
              </p>
            </header>
            <p class="vista__meta">
              {typeof vista.registros === "number" && (
                <span>{vista.registros.toLocaleString("es-MX")} registro(s) · </span>
              )}
              {vista.columnas.length} columna(s)
            </p>
            {vista.descripcion && <p class="vista__descripcion" set:html={enLinea(vista.descripcion)} />}
            {vista.columnas.length > 0 && (
              <div class="tabla-envoltura">
                <table>
                  <caption class="visualmente-oculto">
                    Columnas de {vista.esquema}.{vista.nombre}
                  </caption>
                  <thead>
                    <tr>
                      <th scope="col">#</th>
                      <th scope="col">Columna</th>
                      <th scope="col">Tipo</th>
                      <th scope="col">Nulos</th>
                      <th scope="col">Descripción</th>
                    </tr>
                  </thead>
                  <tbody>
                    {vista.columnas.map((col) => (
                      <tr>
                        <td>{col.posicion}</td>
                        <td>
                          <code>{col.nombre}</code>
                        </td>
                        <td>{col.tipo}</td>
                        <td>{col.nullable ? "Sí" : "No"}</td>
                        <td>{col.descripcion ?? "—"}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          </article>
        ))
      }
      </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .miga {
    font-size: var(--texto-chico);
    color: var(--silenciado);
    margin-bottom: 0.75rem;
  }

  .vista {
    margin-bottom: 1.5rem;
  }

  .vista__descripcion {
    margin: 0 0 0.75rem;
  }

  .enlace-pipeline {
    margin: 0;
  }

  .cabecera {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1.5rem 2.5rem;
    align-items: end;
  }

  .cifras {
    display: grid;
    grid-template-columns: repeat(2, minmax(9rem, 1fr));
    gap: 0.6rem;
    margin: 0;
  }

  .cifra {
    display: flex;
    flex-direction: column-reverse;
    background: var(--tarjeta);
    border: 1px solid var(--linea);
    border-radius: 0.75rem;
    padding: 0.6rem 0.9rem;
    min-width: 0;
  }

  .cifra dd {
    margin: 0;
    color: var(--brand);
    font-size: 1.35rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    line-height: 1.2;
    overflow-wrap: anywhere;
  }

  .cifra dt {
    color: var(--silenciado);
    font-size: var(--texto-chico);
  }

  @media (max-width: 760px) {
    .cabecera {
      grid-template-columns: 1fr;
    }

    .cifras {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .cuerpo {
    display: grid;
    grid-template-columns: 15rem minmax(0, 1fr);
    gap: 2rem;
    margin-top: 2rem;
  }

  .contenido {
    min-width: 0;
  }

  @media (max-width: 960px) {
    .cuerpo {
      grid-template-columns: 1fr;
    }
  }

  .vista__cabecera {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    align-items: baseline;
    flex-wrap: wrap;
  }

  .vista__cabecera h3 {
    margin: 0;
    font-size: var(--texto-subtitulo);
    min-width: 0;
  }

  .titulo-bd {
    font-family: var(--fuente-codigo);
    font-size: var(--texto-seccion);
    font-weight: 600;
  }

  .vista__insignias {
    margin: 0;
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .vista__meta {
    color: var(--silenciado);
    font-size: var(--texto-chico);
    margin: 0.35rem 0 0.75rem;
  }
</style>
