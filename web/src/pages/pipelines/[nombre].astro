---
import Layout from "../../layouts/Layout.astro";
import BarraLateral from "../../components/BarraLateral.astro";
import SeccionPipeline from "../../components/SeccionPipeline.astro";
import { listarPipelines, obtenerDocumento } from "../../lib/documentos";

const clave = Astro.params.nombre ?? "";
const [doc, lista] = await Promise.all([obtenerDocumento(clave), listarPipelines()]);
if (!doc) return new Response(null, { status: 404 });

const CLASIFICACION: Record<string, string> = {
  documentado: "En producción · documentado",
  documentacion_pendiente: "Documentación pendiente",
  posible_desactualizado: "Posible documentación desactualizada",
  sin_verificar: "Sin verificar contra producción",
};

const fuente = doc.secciones.find((s) => s.tipo === "fuente")?.contenido;
const caracteristica = (etiqueta: string) =>
  fuente?.caracteristicas?.find((c: { etiqueta: string }) => c.etiqueta.toLowerCase().startsWith(etiqueta))?.valor;
const chips = [
  doc.base ? `BD: ${doc.base.nombre}` : null,
  caracteristica("frecuencia"),
  caracteristica("desagregaci"),
  caracteristica("primer periodo") ? `Desde ${caracteristica("primer periodo")}` : null,
].filter((c): c is string => Boolean(c)).map((c) => c.replaceAll("`", ""));

const ancla = (s: { tipo: string; id: string }) =>
  ["descripcion", "fuente", "tablas", "vistas", "ejecucion", "variables", "diagrama"].includes(s.tipo) ? s.tipo : `${s.tipo}-${s.id}`;
const secciones = doc.secciones.map((s) => ({ href: `#${ancla(s)}`, texto: s.titulo }));
const indice = lista.findIndex((p) => p.clave === doc.clave);
const anterior = indice > 0 ? lista[indice - 1] : null;
const siguiente = indice >= 0 && indice < lista.length - 1 ? lista[indice + 1] : null;
const otros = lista.map((p) => ({ href: `/pipelines/${p.clave}/`, texto: p.titulo, actual: p.clave === doc.clave }));
---

<Layout
  titulo={`${doc.titulo} — Pipelines del SIEEJ`}
  descripcion={`Documentación técnica del pipeline ${doc.titulo} del SIEEJ: fuente, tablas, vistas, ejecución y diagrama entidad-relación.`}
>
  <section class="portada">
    <div class="contenedor">
      <nav aria-label="Miga de pan" class="miga">
        <a href="/#catalogo">Catálogo</a>
        <span aria-hidden="true"> / </span>
        <span aria-current="page">{doc.titulo}</span>
      </nav>
      <h1>{doc.titulo}</h1>
      {doc.producto && doc.producto !== doc.titulo && <p class="portada__producto">{doc.producto}</p>}
      <ul class="portada__chips" role="list">
        {chips.map((c) => <li>{c}</li>)}
        {doc.clasificacion && <li>{CLASIFICACION[doc.clasificacion] ?? doc.clasificacion}</li>}
      </ul>
    </div>
  </section>

  <div class="contenedor cuerpo">
    <BarraLateral secciones={secciones} otros={otros} tituloOtros="Otros pipelines" />

    <div class="pila contenido">
      {doc.secciones.map((s) => <SeccionPipeline seccion={s} doc={doc} />)}

      <nav class="vecinos" aria-label="Pipelines vecinos">
        {anterior ? <a class="pildora" href={`/pipelines/${anterior.clave}/`}>← {anterior.titulo}</a> : <span />}
        {siguiente && <a class="pildora" href={`/pipelines/${siguiente.clave}/`}>{siguiente.titulo} →</a>}
      </nav>
    </div>
  </div>
</Layout>

<style>
  .portada {
    background: var(--brand-vivo);
    color: #fff;
    padding: 2.5rem 0 2.25rem;
  }

  .portada h1 {
    color: #fff;
    margin: 0;
  }

  .miga {
    font-size: var(--texto-chico);
    margin-bottom: 0.75rem;
    color: rgba(255, 255, 255, 0.85);
  }

  .miga a {
    color: #fff;
  }

  .portada__producto {
    margin: 0.5rem 0 0;
    font-size: 1.125rem;
    font-weight: 500;
  }

  .portada__chips {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .portada__chips li {
    font-size: var(--texto-chico);
    font-weight: 700;
    padding: 0.2rem 0.8rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.14);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.45);
  }

  .cuerpo {
    display: grid;
    grid-template-columns: 15rem minmax(0, 1fr);
    gap: 2rem;
    padding-top: 2.5rem;
  }

  .contenido {
    min-width: 0;
  }

  .vecinos {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .pildora {
    display: inline-flex;
    align-items: center;
    height: 2.5rem;
    padding: 0 1.25rem;
    border-radius: 999px;
    background: var(--brand-suave);
    color: var(--brand);
    font-weight: 700;
    text-decoration: none;
  }

  .pildora:hover {
    background: var(--brand);
    color: #fff;
  }

  @media (max-width: 960px) {
    .cuerpo {
      grid-template-columns: 1fr;
    }
  }
</style>
