# Configuración de la landing de documentación del SIEEJ.
# Copia este archivo a `.env` y completa los valores reales.
# El archivo `.env` NUNCA se versiona (está en .gitignore).

# ── Apache Airflow (API REST, usuario de SOLO LECTURA) ─────────────────────
# La API responde directo por IP dentro de la red del IIEG: no usa túnel SSH.
# Airflow 3.1.1 — expone /api/v2 (la /api/v1 de Airflow 2 fue retirada).
AIRFLOW_BASE_URL=http://10.13.201.115:8080
AIRFLOW_USERNAME=usuario_solo_lectura
AIRFLOW_PASSWORD=cambia-esta-contrasena
# Corridas recientes a consultar por DAG para éxitos/fallos
AIRFLOW_RECENT_RUNS=20

# ── PostgreSQL de producción (usuario de SOLO LECTURA) ─────────────────────
# Si te conectas por el túnel SSH (./scripts/tunel-produccion.sh), usa
# localhost / 15432 en vez del host y puerto internos directos.
PG_HOST=bd.interno.ejemplo
PG_PORT=5432
PG_USER=usuario_solo_lectura
PG_PASSWORD=cambia-esta-contrasena
# Base a la que se conecta para listar las demás
PG_MAINTENANCE_DB=postgres
# Timeout del COUNT(*) exacto antes de caer al estimado del catálogo (ms)
PG_COUNT_TIMEOUT_MS=30000

# ── Documentación estática (rutas EN EL HOST, se montan de solo lectura) ───
# Directorio con los HTML de pipelines (se genera fuera de este repositorio)
DOCS_HTML_DIR_HOST=../general-documentation/etls-pipelines-readmes/html-documents
# Directorio con los markdown de vistas (referencia descriptiva)
VIEWS_MD_DIR_HOST=../general-documentation/etl-views/views-md

# ── Sitio ──────────────────────────────────────────────────────────────────
# URL pública donde se sirve la landing (metadatos SEO/OG)
SITE_URL=https://iieg.jalisco.gob.mx
# Puerto del host donde nginx expone el sitio
WEB_PORT=8080
# Frecuencia de la reconstrucción periódica del builder (segundos; 86400 = diario)
REBUILD_INTERVAL_SECONDS=86400
