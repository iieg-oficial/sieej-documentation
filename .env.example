# Variables de desarrollo (make up). make setup lo copia a .env.development.
# Producción usa .env.production; plantilla en .env.production.example.

# Apache Airflow 3 (API REST v2, usuario de solo lectura)
# Usuario y contraseña se cambian por un JWT en AIRFLOW_TOKEN_PATH; con un JWT ya emitido en
# AIRFLOW_TOKEN, usuario y contraseña van vacíos. Vacías las cuatro, la landing degrada sin Airflow.
AIRFLOW_BASE_URL=<url base de la API de Airflow, p. ej. http://host:8080>
AIRFLOW_USERNAME=<usuario de solo lectura de Airflow, o vacío>
AIRFLOW_PASSWORD=<contraseña de ese usuario, o vacío>
AIRFLOW_TOKEN=<JWT ya emitido, o vacío>
AIRFLOW_TOKEN_PATH=<ruta del intercambio de token, p. ej. /auth/token>
AIRFLOW_RECENT_RUNS=<corridas recientes a consultar por DAG, p. ej. 20>

# PostgreSQL del SIEEJ (usuario de solo lectura). Vacíos host, usuario y contraseña, degrada sin BD.
PG_HOST=<host de PostgreSQL, o vacío>
PG_PORT=<puerto de PostgreSQL, p. ej. 5432>
PG_USER=<usuario de solo lectura, o vacío>
PG_PASSWORD=<contraseña de ese usuario, o vacío>
PG_MAINTENANCE_DB=<base desde la que se listan las demás, p. ej. postgres>
PG_COUNT_TIMEOUT_MS=<timeout del COUNT exacto antes de caer al estimado, en ms, p. ej. 30000>

# ETL-SIEEJ: el builder clona solo core/pipelines para leer el README de cada pipeline.
# Vacía la URL, el clon del volumen se lee tal como esté.
ETL_REPO_URL=<url https del repo ETL-SIEEJ, o vacío>
ETL_REPO_RAMA=<rama de ETL-SIEEJ, p. ej. main>

# mariachi: destino de la sincronización. Vacías las dos, solo se escriben los JSON locales.
# La clave la genera `make mariachi-key`; su huella va a SIEEJ_DOCUMENTACION_SYNC_SHA256 de mariachi.
MARIACHI_URL=<url base de mariachi por el gateway, p. ej. https://portalito.iieg, o vacío>
MARIACHI_SYNC_KEY=<clave del sincronizador, o vacío>
# false solo donde mariachi se publica con un certificado que este nodo no puede validar (espejo con mkcert).
MARIACHI_TLS_VERIFY=<true, o false en el espejo>

# Sitio
SITE_URL=<url pública de la landing, para metadatos SEO y OG>
REBUILD_INTERVAL_SECONDS=<segundos entre reconstrucciones del builder, p. ej. 86400>
WEB_BIND_ADDR=<127.0.0.1 para solo este equipo>
WEB_PORT=<puerto del host, p. ej. 8080>
