---
import Buscador from "./Buscador.astro";
import { ESTADOS, ETAPAS, type Resumen } from "../lib/documentos";

interface Props {
  pipelines: Resumen[];
  generado: string | null;
  verificado: boolean;
}

const ETIQUETAS: Record<string, { texto: string; clase: string }> = {
  documentado: { texto: "En producción · documentado", clase: "insignia--ok" },
  documentacion_pendiente: { texto: "Documentación pendiente", clase: "insignia--pendiente" },
  posible_desactualizado: {
    texto: "Posible documentación desactualizada",
    clase: "insignia--desactualizado",
  },
  sin_verificar: { texto: "Sin verificar contra producción", clase: "insignia--neutra" },
};

const { pipelines: lista, generado: fechaGenerado, verificado } = Astro.props;
const pipelines = lista.map((p) => ({
  ...p,
  etiqueta: ETIQUETAS[p.clasificacion ?? ""] ?? ETIQUETAS.sin_verificar,
}));
const generado = fechaGenerado
  ? new Date(fechaGenerado).toLocaleDateString("es-MX", { year: "numeric", month: "long", day: "numeric" })
  : "—";
---

<section id="catalogo" class="bloque" aria-labelledby="titulo-catalogo">
  <div class="contenedor">
    <h2 id="titulo-catalogo">Catálogo de pipelines en producción</h2>
    <p class="introduccion">
      Un pipeline por fuente de información: cada tarjeta enlaza a su documentación técnica cuando
      existe. Inventario generado el {generado}.
    </p>
    {
      !verificado && (
        <p class="aviso" role="status">
          Este catálogo aún no se ha verificado contra Airflow y la base de datos de producción:
          refleja la documentación estática disponible. El cruce con las fuentes vivas se aplicará
          en la siguiente reconstrucción con acceso a ellas.
        </p>
      )
    }
    <Buscador objetivo="catalogo" etiqueta="Buscar pipeline" placeholder="Buscar pipeline por nombre o fuente" />
    <ul class="rejilla" role="list" data-buscable="catalogo">
      {
        pipelines.map((p) => (
          <li class="tarjeta tarjeta-pipeline" data-buscar={`${p.titulo} ${p.clave} ${p.producto}`}>
            <div class="tarjeta-pipeline__cabecera">
              <h3 class="tarjeta-pipeline__titulo">{p.titulo}</h3>
              <span class={`insignia ${p.etiqueta.clase}`}>{p.etiqueta.texto}</span>
            </div>
            <p class="tarjeta-pipeline__meta">
              <code>{p.clave}</code>
              {p.vistasDocumentadas > 0 && (
                <span> · {p.vistasDocumentadas} vista(s) documentada(s)</span>
              )}
              {typeof p.vistasEnBd === "number" && (
                <span> · {p.vistasEnBd} vista(s) en BD</span>
              )}
            </p>
            {p.etapas.length > 0 && (
              <ul class="tarjeta-pipeline__etapas">
                {p.etapas.map((e) => (
                  <li>
                    <span class="etapa__nombre">{e.etapa ? ETAPAS[e.etapa] ?? e.etapa : "Etapa única"}</span>
                    <code>{e.dag_id}</code>
                    {e.pausado && <span class="etapa__pausada"> · pausado</span>}
                    {e.ultima_corrida_estado && (
                      <span> · última corrida: {ESTADOS[e.ultima_corrida_estado] ?? e.ultima_corrida_estado}</span>
                    )}
                    {e.corridas_recientes && e.corridas_recientes.total > 0 && (
                      <span> · {e.corridas_recientes.exitos} de {e.corridas_recientes.total} recientes con éxito</span>
                    )}
                  </li>
                ))}
              </ul>
            )}
            <p class="tarjeta-pipeline__acciones">
              <a class="pildora" href={`/pipelines/${p.clave}/`}>
                Documentación
                <span class="visualmente-oculto"> de {p.titulo}</span>
              </a>
              {p.vistasDocumentadas > 0 || typeof p.vistasEnBd === "number" ? (
                <a class="pildora" href={`/pipelines/${p.clave}/#vistas`}>
                  Vistas
                  <span class="visualmente-oculto"> de {p.titulo}</span>
                </a>
              ) : null}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .rejilla {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 1rem;
  }

  .tarjeta-pipeline {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .tarjeta-pipeline__cabecera {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .tarjeta-pipeline__titulo {
    margin: 0;
    font-size: var(--texto-subtitulo);
    min-width: 0;
  }

  .tarjeta-pipeline__meta {
    margin: 0;
    color: var(--silenciado);
    font-size: var(--texto-chico);
  }

  .tarjeta-pipeline__etapas {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.2rem;
    color: var(--silenciado);
    font-size: var(--texto-chico);
  }

  .tarjeta-pipeline__etapas code {
    background: var(--linea);
    color: var(--tinta);
  }

  .etapa__nombre {
    font-weight: 700;
    color: var(--titulo);
  }

  .etapa__nombre::after {
    content: " ·";
  }

  .etapa__pausada {
    font-style: italic;
  }

  .tarjeta-pipeline__acciones {
    margin: auto 0 0;
    padding-top: 0.75rem;
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .pildora {
    display: inline-flex;
    align-items: center;
    height: 2.25rem;
    padding: 0 1rem;
    border-radius: 999px;
    background: var(--brand-suave);
    color: var(--brand);
    font-size: var(--texto-chico);
    font-weight: 700;
    text-decoration: none;
    transition: background 0.15s, color 0.15s;
  }

  a.pildora:hover,
  a.pildora:focus-visible {
    background: var(--brand);
    color: #fff;
  }

  .pildora--inactiva {
    background: var(--linea);
    color: var(--silenciado);
  }

  .silenciado {
    color: var(--silenciado);
  }

</style>
