---
import Layout from "../layouts/Layout.astro";
import SeccionSieej from "../components/SeccionSieej.astro";
import SeccionCatalogo from "../components/SeccionCatalogo.astro";
import SeccionNumeralia from "../components/SeccionNumeralia.astro";
import SeccionVistas from "../components/SeccionVistas.astro";
import FlujoDatos from "../components/FlujoDatos.astro";
import { leerJson } from "../lib/datos";
import { leerInventario, listarPipelines } from "../lib/documentos";

const [pipelines, inventario, numeralia, vistas] = await Promise.all([
  listarPipelines(),
  leerInventario(),
  leerJson<any>("numeralia.json"),
  leerJson<any>("vistas.json"),
]);
---

<Layout>
  <section class="heroe" aria-labelledby="titulo-heroe">
    <div class="contenedor heroe__rejilla">
      <div class="heroe__texto">
        <p class="heroe__direccion">Dirección del Sistema de Información</p>
        <h1 id="titulo-heroe">Sistema de Información Estratégica del Estado de Jalisco</h1>
        <p class="heroe__resumen">
          Documentación pública del SIEEJ: qué es el sistema, el catálogo de sus pipelines ETL en
          producción, la numeralia que cruza Airflow con la base de datos, y la estructura de sus
          vistas materializadas.
        </p>
      </div>
      <div class="heroe__imagen">
        <FlujoDatos />
      </div>
    </div>
  </section>

  <SeccionSieej />
  <SeccionCatalogo
    pipelines={pipelines}
    generado={inventario?.generado ?? null}
    verificado={Boolean(inventario?.resumen?.verificado_contra_produccion)}
  />
  {numeralia && <SeccionNumeralia numeralia={numeralia} />}
  {vistas && <SeccionVistas vistas={vistas} />}
</Layout>

<style>
  .heroe {
    background: var(--brand-vivo);
    color: #fff;
    padding: 3rem 0 2.5rem;
  }

  .heroe__rejilla {
    display: grid;
    align-items: start;
    gap: 2rem;
  }

  .heroe__texto {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .heroe__texto > * {
    margin: 0;
  }

  .heroe__direccion {
    font-weight: 500;
    color: rgba(255, 255, 255, 0.85);
  }

  .heroe h1 {
    color: #fff;
  }

  .heroe__resumen {
    max-width: 44rem;
    font-size: clamp(1.25rem, 1.871vw + 0.704rem, 1.375rem);
    line-height: 1.45;
    font-weight: 500;
    color: #fff;
  }

  .heroe__imagen {
    order: -1;
    justify-self: center;
    height: 18rem;
    max-width: 100%;
    aspect-ratio: 512 / 596;
    border-radius: 1.5rem;
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .heroe {
      padding-top: 4rem;
      padding-bottom: 4rem;
    }

    .heroe__rejilla {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 3rem;
    }

    .heroe__imagen {
      order: 0;
      justify-self: end;
      height: 26rem;
    }
  }
</style>
